\documentclass{article}
\input regression-test.tex
\usepackage[noindex]{nehgs-register}

\definepersonkv{ancestor}{
  name      = {Ancestor Person},
  preferred = {Ancestor},
  parents   = {}
}

\definepersonkv{descendant}{
  name      = {Descendant Person},
  preferred = {Descendant},
  parents   = {ancestor},
  lineage-parent = {ancestor}
}

\begin{document}
\START
\TEST{Xrefperson output}{
  \begin{registersection}
  \mainperson{ancestor} test.
  \mainperson{descendant} test.
  See \xrefperson{ancestor}.
  \end{registersection}
}

\TEST{Childname output}{
  \childname{ancestor} and \childname{descendant}.
}

\OMIT
\end{document}
