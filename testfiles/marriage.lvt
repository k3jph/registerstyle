\documentclass{article}
\input regression-test.tex
\usepackage[en-US]{datetime2}
\usepackage[date=en-US,noindex]{registerstyle}

\definepersonkv{husband}{
  name    = {John Husband},
  parents = {},
  sex     = {M}
}

\definepersonkv{wife-one}{
  name    = {First Wife},
  parents = {},
  sex     = {F}
}

\definepersonkv{wife-two}{
  name    = {Second Wife},
  parents = {},
  sex     = {F}
}

\definepersonkv{inline-test}{
  name           = {Inline Test},
  parents        = {},
  marriage-date  = {1900-05-01},
  marriage-place = {Boston, Massachusetts}
}

\addmarriage{husband}{
  spouse = wife-one,
  date   = 1850-06-15,
  place  = {Hartford, Connecticut}
}

\addmarriage{husband}{
  spouse = wife-two,
  date   = 1865-09-20,
  place  = {New Haven, Connecticut}
}

\begin{document}
\START
\TEST{Marriage count storage}{
  \TYPE{husband count: \csuse{r@marriagecount@husband}}
  \TYPE{inline count: \csuse{r@marriagecount@inline-test}}
  \TYPE{wife-one count: \csuse{r@marriagecount@wife-one}}
}

\TEST{Marriage data storage}{
  \TYPE{m1 date: \csuse{r@marriagedate@husband@1}}
  \TYPE{m1 place: \csuse{r@marriageplace@husband@1}}
  \TYPE{m1 spouse: \csuse{r@marriagespouse@husband@1}}
  \TYPE{m2 date: \csuse{r@marriagedate@husband@2}}
  \TYPE{m2 place: \csuse{r@marriageplace@husband@2}}
  \TYPE{m2 spouse: \csuse{r@marriagespouse@husband@2}}
}

\TEST{Marriage accessor output}{
  First marriage date: \getmarriagedate{husband}{1}.
  First marriage place: \getmarriageplace{husband}{1}.
  First marriage spouse: \getmarriagespouse{husband}{1}.
  Second marriage date: \getmarriagedate{husband}{2}.
  Second marriage place: \getmarriageplace{husband}{2}.
  Second marriage spouse: \getmarriagespouse{husband}{2}.
}

\TEST{Inline marriage keys}{
  \TYPE{inline date: \csuse{r@marriagedate@inline-test@1}}
  \TYPE{inline place: \csuse{r@marriageplace@inline-test@1}}
  Inline date: \getmarriagedate{inline-test}{1}.
  Inline place: \getmarriageplace{inline-test}{1}.
}

\TEST{Missing marriage warning}{
  \getmarriagedate{husband}{3}.
}

\OMIT
\end{document}
